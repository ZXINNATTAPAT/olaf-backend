# Database Configuration
# Option 1: Use connection string (recommended for Neon)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Option 2: Use individual parameters (fallback)
# DB_NAME=olaf_backend
# DB_USER=zxin
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,olaf-backend.onrender.com

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://olafs.netlify.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://olafs.netlify.app

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
